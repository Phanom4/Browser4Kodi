<?xml version="1.0" encoding="UTF-8"?>
<addon id="browser4kodi"
       name="Browser4Kodi"
       version="k21_3_c150"
       provider-name="Phanom4">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.script"
               library="main.py"/>

    <extension point="xbmc.service"
               library="service.py"
               start="startup"/>

    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Browser für Kodi</summary>
        <description lang="de_DE">Browser für Kodi</description>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
    </extension>

</addon>
