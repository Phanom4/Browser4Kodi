<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.browser.installer"
       name="Browser-Installer"
       version="0.0.1"
       provider-name="Phanom4">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="main.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Browser verwalten</summary>
        <description lang="de_DE">Installiert, deinstalliert oder entfernt den Browser über den zentralen Installer.</description>
        <platform>linux</platform>
    </extension>
</addon>
